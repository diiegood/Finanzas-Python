#Usando la CVXPY library para craer la funcion del mejor subconjunto, 
#sirve para resolver problemas de optimizacion, para encontrar el mejor subconjunto


def best_subset(x,y,1_0):
    M = 1000
    n_factor = x.shape[1]
    z= cp.variable(n_factor, boolean = True) #variable
    beta = cp.Variable(n_factor)  #variable
    alpha = cp.Variable(1) #intercepto definido como variable
    
    def MIP_obj(x,y,b,a):
        return cp.norm(y-cp.matmul(x,b)- a,2)
    
    best_subset_prob = cp.Problem(cp.Minimize(MIP_obj(x,y,beta,alpha)), #se definen los constrains / limitantes del problema de optimizacion
                                  [cp.sum(z)<=1_0, beta+M*z>=0, M*z>=beta])  
    best_subset_prob.solve(solver="ECOS_BB") #se usa solver para optimizar la ecuacion de la matriz
    return alpha.value, beta.value    #que nos regrese los valores alfa y beta, siendo los valores de la solucion

    
