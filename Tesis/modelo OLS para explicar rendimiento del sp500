import numpy as np
import matplotlib.pyplot as plt

# Activo
ticker = "^GSPC"  # S&P 500

# Periodo de análisis
start_date = "2010-01-01"
end_date = "2026-12-31"

# Descarga de datos de Yahoo Finance
data = yf.download(
    ticker,
    start=start_date,
    end=end_date,
    interval="1d",
    auto_adjust=False
)

# Obtención del precio de cierre
close_prices = data["Close"].dropna()
close_prices.index.name = "Fecha"

# Cálculo de retornos logarítmicos
log_returns = np.log(close_prices / close_prices.shift(1)).dropna()

# Retorno acumulado
cumulative_returns = np.exp(log_returns.cumsum())

# Gráfica
plt.figure(figsize=(14, 7))

plt.plot(
    cumulative_returns.index,
    cumulative_returns,
    label=ticker
)

plt.title(
    "Serie de tiempo – S&P 500 (2010–2026)",
    fontsize=14
)

plt.xlabel("Fecha")
plt.ylabel("Crecimiento relativo")
plt.legend(loc="upper left")
plt.grid(True)
plt.tight_layout()
plt.show()


