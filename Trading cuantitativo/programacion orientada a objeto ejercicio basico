#Calcular el rendimiento de una accion y ver su nombre 


class Accion:
    def __init__(self, nombre, precio):
        self.nombre = nombre
        self.precio = precio

    def calcular_rendimiento(self, precio_inicial):
        return (self.precio / precio_inicial) - 1


# Crear un objeto
apple = Accion("Apple", 200)

# Utilizar su método
rendimiento = apple.calcular_rendimiento(180)

print(apple.nombre)
print(rendimiento)


